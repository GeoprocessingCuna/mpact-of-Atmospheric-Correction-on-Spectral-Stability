    y = "Surface Reflectance Factor (0 to 1)",
    title = "Spectral Signature Evolution Across Crop Years and Phenological Stages",
    subtitle = "Zonal mean canopy mapping clean of spatial pseudoreplication errors and atmospheric noise"
  ) +
  theme_bw(base_size = 12) +
  theme(
    panel.grid.minor = element_blank(),
    strip.background = element_rect(fill = "grey95"),
    strip.text = element_text(face = "bold"),
    axis.text.x = element_text(face = "bold"),
    legend.position = "bottom"
  )

print(plot_fenologia_safra)
